# PostgreSQL connection string. Leave empty in development to use the embedded
# PGlite database stored in .data/pglite (no install needed).
DATABASE_URL=""

# Port for the Express + Socket.IO server.
PORT=3000

# Where uploaded files (attachments, voice notes, covers) are stored, and the
# per-file size limit in MB.
UPLOAD_DIR=".data/uploads"
MAX_UPLOAD_MB=10

# Google Drive API key (Google Cloud Console → enable "Google Drive API" →
# Credentials → API key). The Drive folder must be shared "Anyone with the link".
GOOGLE_DRIVE_API_KEY=""

# Coffee treat payment details shown to students (kept out of the frontend bundle).
COFFEE_AMOUNT_PKR=250
COFFEE_PAYMENT_METHOD=""
COFFEE_ACCOUNT_NUMBER=""
COFFEE_ACCOUNT_TITLE=""
